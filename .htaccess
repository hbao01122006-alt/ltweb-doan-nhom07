# Danh cho Apache 2.4 (XAMPP): php -S khong doc .htaccess.
Options -Indexes

# Khong cong khai tep va thu muc an.
RedirectMatch 404 /\.(?!well-known/)

# Ngan truy cap cac thu muc noi bo va tep cau hinh.
RedirectMatch 404 /(inc|src|vendor|database|logs|storage|tests|kiemtra)(/|$)
<FilesMatch "\.(sql|log|bak|ini|lock)$|^composer\.json$">
    Require all denied
</FilesMatch>
